{
  "name": "postext",
  "description": "A programmable typesetter for the web. Layout engine that applies professional editorial rules — columns, orphan/widow prevention, balanced columns, resource placement, running heads — to semantic content. Built on @chenglou/pretext for DOM-free text measurement.",
  "version": "1.4.2",
  "type": "module",
  "license": "MIT",
  "homepage": "https://postext.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/drnachio/postext.git",
    "directory": "packages/postext"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./worker": {
      "types": "./dist/worker/client.d.ts",
      "default": "./dist/worker/client.js"
    },
    "./worker/entry": {
      "types": "./dist/worker/layout.worker.d.ts",
      "default": "./dist/worker/layout.worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/bundle-mathjax.mjs",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "BENCH=1 vitest run __bench__",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@postext/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "mathjax-full": "^3.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "1.0.0-rc.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "hyphenation.ca": "^0.2.1",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.es": "^0.2.1",
    "hyphenation.fr": "^0.2.1",
    "hyphenation.it": "^0.2.1",
    "hyphenation.nl": "^0.2.1",
    "hyphenation.pt": "^0.2.1",
    "hypher": "^0.2.5"
  }
}

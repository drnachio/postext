{
  "name": "postext-idml",
  "version": "0.8.1",
  "description": "InDesign Markup (IDML) for Postext, in both directions: a laid-out book as an IDML package that InDesign opens as the PDF shows it, and an IDML package as a Postext book. A typed IDML reader, no dependency on InDesign.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://postext.dev/",
  "keywords": [
    "postext",
    "idml",
    "indesign",
    "import",
    "export",
    "typesetting",
    "typography",
    "print"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drnachio/postext.git",
    "directory": "packages/postext-idml"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "default": "./dist/import/index.js"
    },
    "./read": {
      "types": "./dist/read/index.d.ts",
      "default": "./dist/read/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "postext": "workspace:^"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@postext/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "postext": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}

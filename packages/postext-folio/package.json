{
  "name": "postext-folio",
  "version": "0.11.2",
  "description": "A 3D book viewer for Postext documents and page images: three.js leaves that curl, cast real shadows and turn by hand, for left- and right-bound books.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://postext.dev/",
  "keywords": [
    "postext",
    "flipbook",
    "page-flip",
    "page-curl",
    "book",
    "three",
    "webgl",
    "viewer",
    "typography"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drnachio/postext.git",
    "directory": "packages/postext-folio"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "postext": "workspace:^",
    "three": ">=0.160.0",
    "hls.js": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@postext/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.4",
    "hls.js": "^1.7.3",
    "postext": "workspace:*",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}

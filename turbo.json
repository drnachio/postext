{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "POSTEXT_PRIVATE_PRESETS_DIR"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/**",
        "$TURBO_ROOT$/apps/web/messages/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/cookbook/**",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/rust/**",
        "!$TURBO_ROOT$/rust/target/**"
      ],
      "env": [
        "EPUBCHECK",
        "VERAPDF",
        "COOKBOOK_PREVIEW",
        "COOKBOOK_FORCE_CONFIG",
        "POSTEXT_QUICK_TESTS"
      ]
    },
    "lint": {},
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "web#build": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/cookbook/**"
      ],
      "env": [
        "COOKBOOK_DRAFTS",
        "POSTEXT_WEB_DIR"
      ]
    }
  }
}
